<?xml version="1.0"?>
<package format="2">
  <name>distributed_rl_formation</name>
  <version>0.1.0</version>
  <description>Four-robot consistency formation and RL collision-avoidance validation in ROS Stage.</description>

  <maintainer email="uav-learning-lab@users.noreply.github.com">uav-learning-lab</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>message_runtime</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>stage_ros_add_pose_and_crash</exec_depend>

  <export/>
</package>
